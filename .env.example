# Copy to .env for local runs. In CI/cloud sessions these come from secrets (see docs/SETUP.md).
DATABASE_URL=postgresql://postgres:password@db.xxxxx.supabase.co:5432/postgres
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
ANTHROPIC_API_KEY=
VOYAGE_API_KEY=
META_ACCESS_TOKEN=
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v24.0
YOUTUBE_API_KEY=
# Salt for hashing public usernames (any long random string; never change once set)
AUTHOR_HASH_SALT=
